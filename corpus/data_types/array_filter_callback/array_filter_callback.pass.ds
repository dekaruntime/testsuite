import { echo } from "io"
const arr = [1, 2, 3, 4]
const evens = arr.filter(fn(x: number) boolean { return x % 2 == 0 })
const len: number = evens.length
const first: number = evens.has(0) ? evens[0] : 0
const second: number = evens.has(1) ? evens[1] : 0
echo(string(len))
echo(string(first))
echo(string(second))
