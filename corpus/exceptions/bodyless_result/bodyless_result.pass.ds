import { echo } from "io"
fn data(fail: boolean) Result<number, string> { if (fail) { return Err("bad"); } return Ok(7); }
fn raised(fail: boolean) Result<number, string> { const n = match data(fail) { Ok(v) => v, Err(e) }; return Ok(n + 1); }
echo(string(match raised(false) { Ok(v) => v, Err(e) => 0 }));
echo(match raised(true) { Ok(v) => string(v), Err(e) => e });
