import { echo } from "io"
fn source(fail: boolean) Exception<number, string> { if (fail) { return Throw("bad"); } return Ok(7); }
const data: Result<number, string> = source(true).to_result();
echo(match data { Ok(v) => string(v), Err(e) => e });
echo(match Exception.from(data) { Ok(v) => string(v), Throw(e) => e });
