{
  "name": "deka-test-suite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy:monaco": "rm -rf public/monaco-editor && mkdir -p public/monaco-editor/min && cp -R node_modules/monaco-editor/min/vs public/monaco-editor/min/vs && node scripts/verify-monaco-assets.mjs",
    "dev": "next dev",
    "ingest": "bun scripts/ingest.mjs",
    "build": "bun run copy:monaco && bun scripts/ingest.mjs && next build",
    "deploy": "wrangler deploy",
    "start": "next start",
    "lint": "eslint",
    "test": "bun test lib"
  },
  "dependencies": {
    "@dekaruntime/web-ide-kit": "^0.3.1",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "monaco-editor": "0.52.2",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.125.0"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
